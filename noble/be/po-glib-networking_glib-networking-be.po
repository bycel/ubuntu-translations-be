msgstr "Не атрымалася стварыць злучэнне TLS: %s"

#: tls/gnutls/gtlsconnection-gnutls.c:436
#: tls/gnutls/gtlsconnection-gnutls.c:445
#: tls/gnutls/gtlsconnection-gnutls.c:455
#: tls/openssl/gtlsconnection-openssl.c:158
#, c-format
msgid "Peer failed to perform TLS handshake: %s"
msgstr ""
"Аднарангаваму вузлу не ўдалося здзейсніць пацвярджэнне сувязі TLS: %s"

#: tls/gnutls/gtlsconnection-gnutls.c:462
#: tls/openssl/gtlsconnection-openssl.c:207
msgid "TLS connection closed unexpectedly"
msgstr "Злучэнне TLS нечакана закрылася"

#: tls/gnutls/gtlsconnection-gnutls.c:477
#: tls/openssl/gtlsconnection-openssl.c:176
msgid "TLS connection peer did not send a certificate"
msgstr "Аднарангавы вузел злучэння TLS не адправіў сертыфікат"

#: tls/gnutls/gtlsconnection-gnutls.c:491
#, c-format
