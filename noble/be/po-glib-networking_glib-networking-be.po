#: tls/openssl/gtlsdatabase-openssl.c:434
msgid "Could not create CA store"
msgstr "Не атрымалася стварыць сховішча ЦС"

#: tls/openssl/gtlsserverconnection-openssl.c:186
#, c-format
msgid "There is a problem with the certificate: %s"
msgstr "Узнікла праблема з сертыфікатам: %s"

#: tls/openssl/gtlsserverconnection-openssl.c:195
#, c-format
msgid "There is a problem with the certificate private key: %s"
msgstr "Узнікла праблема з прыватным ключом сертыфіката: %s"
