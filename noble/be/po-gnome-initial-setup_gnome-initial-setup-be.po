#: gnome-initial-setup/gis-assistant.c:427
msgid "_Next"
msgstr "_Далей"

#: gnome-initial-setup/gis-assistant.c:428
msgid "_Finish"
msgstr "Завяр_шыць"

#: gnome-initial-setup/gis-assistant.c:432
msgid "_Accept"
msgstr "_Прыняць"

#: gnome-initial-setup/gis-assistant.c:429
